# Copy to .env (gitignored) and change every value.
MSSQL_SA_PASSWORD=YourStrong!Passw0rd
# 32-byte base64 AES key; generate with: openssl rand -base64 32
CV_ENCRYPTION_KEY=CHANGE_ME_base64_32_bytes
# 32-byte base64 HMAC signing key; generate with: openssl rand -base64 32
CV_AUTH_SIGNING_KEY=CHANGE_ME_base64_32_bytes
